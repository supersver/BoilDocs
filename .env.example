# Server-side only — read by Vercel functions, never bundled into client JS.
# Set these in your Vercel project dashboard (or in .env for local dev).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Set to "true" to skip /api/summarize entirely and use local mock data.
# Useful for UI-only development without a running n8n instance.
VITE_USE_MOCK=true
